     "output_type": "stream",
     "text": [
      "Step 0\n",
      "Step 1\n",
      "Step 2\n",
      "Step 3\n",
      "Step 4\n"
     ]
    }
   ],
   "source": [
    "for step in range(5):       # goes from 0 to 4 (5 steps)\n",
    "    print(f\"Step {step}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7e0a4df8",
   "metadata": {},
   "source": [
